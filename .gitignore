# Build trees (build, build-noasm, build-release, build-release-noasm, ...)
/build*/

# Symlink to build/compile_commands.json for clangd, and clangd's index
/compile_commands.json
/.cache/

# Per-user settings, written with the defaults on first run
/raycaster.cfg

# Editor leftovers
*.swp
*~
.vscode/
.idea/

# Note: assets/ is checked in on purpose, including the generated textures,
# sprites, sounds and music (rerun gen_textures / gen_sounds to change them).
